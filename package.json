{
  "name": "aegis-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aegis - Confidential Financial Intelligence Platform built on Flare",
  "scripts": {
    "dev": "pnpm --filter \"@aegis/*\" --parallel dev",
    "build": "pnpm tsc --build && pnpm --filter \"@aegis/*\" build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sol}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sol}\"",
    "prepare": "husky",
    "clean": "pnpm --filter \"@aegis/*\" clean && rimraf node_modules **/dist **/build"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.4.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,sol}": [
      "prettier --write"
    ]
  }
}
